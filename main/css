/* General Styles */
body {
  font-family: Arial, sans-serif;
  background-color: #f4f4f9;
  margin: 0;
  padding: 0;
}

header {
  background-color: #333;
  color: white;
  padding: 1rem;
  text-align: center;
}

nav ul {
  list-style-type: none;
  padding: 0;
}

nav ul li {
  display: inline;
  margin: 0 15px;
}

nav ul li a {
  color: white;
  text-decoration: none;
  font-weight: bold;
}

section {
  padding: 50px;
  text-align: center;
}

#hero {
  background-color: #2b2b2b;
  color: white;
  padding: 100px;
}

h1, h2 {
  color: #333;
}

footer {
  background-color: #333;
  color: white;
  text-align: center;
  padding: 1rem;
  position: absolute;
  bottom: 0;
  width: 100%;
}

ul {
  padding: 0;
  list-style-type: none;
}

ul li {
  font-size: 1.1rem;
  margin-bottom: 10px;
}

ul li a {
  color: #333;
  text-decoration: none;
}
